# Build artifacts
.build/
DerivedData/
*.xcodeproj/
*.xcworkspace/

# The built app
AIMacCleaner.app/
/Applications/AIMacCleaner.app

# 发布产物（DMG + sha256 由 build_release.sh 生成，不入库）
dist/

# Backup files created by the app
Library/Application Support/AIMacCleaner/backups/

# macOS Finder metadata
.DS_Store
Thumbs.db

# Swift Package Manager artifacts
Packages/
.swiftpm/

# Shell script artifacts
*.log
*.out

# Python artifacts & temp dirs
__pycache__/
._*tmpdir/

# Icon generation temp files
icon_*.png

# 图标生成过程的中间产物与旧版备份（最终图标见 Sources/IconGen/AIMacCleaner.png）
generated-icons/
Sources/IconGen/*.bak_*
Sources/IconGen/*.bak

# Project assistant data
.workbuddy/

# 打包时由 build_app.sh 注入的版本号（日期制），以及同日构建计数器
Sources/AIMacCleaner/AppVersion.generated.swift
.build_version_state
